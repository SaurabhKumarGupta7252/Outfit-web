# --- Server ---
NODE_ENV=development
PORT=3000
APP_NAME=AI Outfit Changer
# Comma-separated list of allowed browser origins. Empty = no browser origins (mobile apps are unaffected).
CORS_ORIGINS=
# Set to the number of proxies in front of the API (e.g. 1 behind a load balancer) so client IPs are correct.
TRUST_PROXY=0

# --- Database (local dev: docker compose up -d) ---
DATABASE_URL=postgresql://outfit:outfit@localhost:5432/outfit_dev
TEST_DATABASE_URL=postgresql://outfit:outfit@localhost:5432/outfit_test

# --- Auth ---
# openssl rand -base64 48
AUTH_TOKEN_SECRET=replace_with_at_least_32_random_bytes
# Separate secret used to hash IP addresses for abuse checks. openssl rand -base64 32
IP_HASH_SECRET=replace_with_random_value
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# OAuth client IDs whose Google ID tokens are accepted (the Web client ID used as serverClientId in Flutter). Comma-separated.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Images (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=outfit-api

# --- Magic Hour (used from the generation milestone) ---
MAGIC_HOUR_API_KEY=

# --- Google Play (used from the purchases milestone) ---
GOOGLE_PLAY_PACKAGE_NAME=ai.outfit.studio
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=